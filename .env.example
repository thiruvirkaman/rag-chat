# Primary LLM: Ollama Cloud (GLM-5.2 via Ollama native API)
# Get your key at https://ollama.com/settings/keys
OLLAMA_API_KEY=your-ollama-api-key
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=glm-5.2:cloud

# Hugging Face fallback model (loaded via transformers, runs on GPU/CPU)
HF_FALLBACK_MODEL=Qwen/Qwen2-0.5B-Instruct

# Embeddings model (sentence-transformers, runs locally)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Set to "cuda" if you have an NVIDIA GPU, else "cpu"
HF_DEVICE=cuda

# Number of top chunks to retrieve per query
TOP_K=4